# Only model-backed benchmarks need these settings. The local demo does not.
# Replace the blank values with IDs your Vertex AI project can access.
# See docs/SETUP.md for authentication and other provider configurations.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
HARNESS2_SOLVER_MODEL=
HARNESS2_IMPROVER_MODEL=
HARNESS2_JUDGE_MODEL=

# The solver/improver use provider/model IDs (for example google-vertex/...).
# The judge uses a bare model ID. An empty improver defaults to the solver.
# Use a fresh output root when changing models or task selection.
HARNESS2_RUNS_DIR=runs

# Optional Codex executor: a Responses API endpoint, not a subscription login.
# HARNESS2_CODEX_BASE_URL=
# HARNESS2_CODEX_API_KEY=
# HARNESS2_CODEX_MODEL=
