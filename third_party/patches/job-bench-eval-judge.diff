+def _claude_blocks(user_content) -> list[dict]:
+    """OpenAI chat content -> Anthropic content blocks; image_url data URLs become base64 images."""
+    if isinstance(user_content, str):
+        return [{"type": "text", "text": user_content}]
+    blocks = []
+    for part in user_content:
+        if part.get("type") == "image_url":
+            head, _, data = part["image_url"]["url"].partition(",")
+            mime = head.removeprefix("data:").removesuffix(";base64")
+            blocks.append({"type": "image", "source": {"type": "base64", "media_type": mime, "data": data}})
+        else:
+            blocks.append({"type": "text", "text": part.get("text", "")})
+    return blocks
+
+
+def call_claude_cli(judge_model: str, system: str, user_content, timeout_sec: int) -> str:
+    """JUDGE_BACKEND=claude_cli: one tool-less Claude Code session per rubric, prompt on stdin.
+
+    Claude Code takes its credentials from the environment (Vertex AI, ANTHROPIC_API_KEY or a
+    subscription CLAUDE_CODE_OAUTH_TOKEN). Temperature cannot be set; JUDGE_REASONING_EFFORT
+    maps to --effort. JUDGE_CLAUDE_CONFIG_ISOLATED=1 gives each call an empty config dir.
+    """
+    cmd = [
+        os.environ.get("JUDGE_CLAUDE_BIN") or "claude",
+        "-p",
+        "--input-format", "stream-json",
+        "--output-format", "stream-json",
+        "--verbose",
+        "--model", judge_model,
+        "--system-prompt", system,
+        "--tools", "",
+        "--strict-mcp-config",
+        "--setting-sources", "",
+        "--no-session-persistence",
+    ]
+    effort = os.environ.get("JUDGE_REASONING_EFFORT", "low").strip()
+    if effort and effort.lower() != "default":
+        cmd += ["--effort", effort]
+    message = {"type": "user", "message": {"role": "user", "content": _claude_blocks(user_content)}}
+    with tempfile.TemporaryDirectory(prefix="judge-claude-") as cwd:
+        env = dict(os.environ)
+        if env.get("JUDGE_CLAUDE_CONFIG_ISOLATED") == "1":
+            env["CLAUDE_CONFIG_DIR"] = os.path.join(cwd, ".config")
+        r = subprocess.run(
+            cmd, input=json.dumps(message) + "\n", cwd=cwd, env=env,
+            capture_output=True, text=True, timeout=timeout_sec,
+        )
+    result = None
+    for line in r.stdout.splitlines():
+        try:
+            event = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        if isinstance(event, dict) and event.get("type") == "result":
+            result = event
+    if result is None:
+        raise RuntimeError(f"claude exited {r.returncode} without a result: {(r.stderr or r.stdout)[-300:]}")
+    text = result.get("result") if isinstance(result.get("result"), str) else ""
+    if result.get("is_error") or not text.strip():
+        raise RuntimeError(f"claude judge error ({result.get('subtype')}): {text[:300]}")
+    return text
+
